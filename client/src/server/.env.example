NODE_ENV=development
PORT=5000
# Local MongoDB, or paste your MongoDB Atlas connection string here
MONGODB_URI=mongodb://127.0.0.1:27017/student-ontrack
# Comma-separated frontend origins allowed to call the API
FRONTEND_URL=http://localhost:5173
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
